# Copie este arquivo para ".env" (que é ignorado pelo Git) e preencha com
# valores reais. Nunca coloque a senha de verdade aqui neste arquivo de exemplo.

# Conta Gmail usada para enviar os emails de convite de novas organizações.
GMAIL_USER=seuemail@gmail.com

# Senha de APP do Gmail (não é a senha normal da conta).
# Gerar em: https://myaccount.google.com/apppasswords
# (precisa ter a verificação em duas etapas ativada na conta Google)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
